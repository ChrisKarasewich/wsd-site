# Cache rules. Pages, CSS and JS revalidate on every visit, so an edit shows up
# on the next page load (their file names don't change between releases, so a
# long cache would keep serving the old version). Images and icons are cached
# for a week.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=604800

/favicon/*
  Cache-Control: public, max-age=604800

/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate
