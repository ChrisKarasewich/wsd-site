{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wsd-site",
  "compatibility_date": "2026-05-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Serve the repo root. .assetsignore keeps repo-only files off the live site.
    "directory": ".",
    // /services serves services.html, and /services.html redirects to /services.
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get the branded 404.html with a real 404 status.
    "not_found_handling": "404-page"
  },
  "compatibility_flags": ["nodejs_compat"]
}
